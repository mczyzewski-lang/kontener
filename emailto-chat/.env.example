# emailto.chat — environment variables. Copy to .env (gitignored) and fill in.
# All variables are validated at request time (src/server/env.ts), so `next build` works without them.

# Public base URL of the app, no trailing slash. OAuth redirect URI = ${APP_URL}/api/auth/google/callback
APP_URL=http://localhost:3000

# PostgreSQL connection string (Prisma).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/emailtochat
# Used by `npm test` only (defaults to the value below).
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/emailtochat_test

# Google OAuth 2.0 client (type "Web application") from Google Cloud Console → APIs & Services → Credentials.
# Authorized redirect URI: ${APP_URL}/api/auth/google/callback. Enable the Gmail API in the project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 32 random bytes, base64. Encrypts OAuth tokens at rest (AES-256-GCM).  openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# ≥ 32 characters. HMAC key for the signed OAuth state cookie.        openssl rand -base64 48
SESSION_SECRET=
# Bearer secret for /api/cron/sync (Vercel Cron sends it automatically when set in the project).
CRON_SECRET=

# --- Optional: Gmail push notifications via Cloud Pub/Sub ------------------------------------------
# Topic Gmail publishes to: projects/<project-id>/topics/<topic>. Grant
# gmail-api-push@system.gserviceaccount.com the "Pub/Sub Publisher" role on it.
GMAIL_PUBSUB_TOPIC=
# Push subscription → ${APP_URL}/api/webhooks/gmail. Verify it with an OIDC token (recommended) …
PUBSUB_SERVICE_ACCOUNT_EMAIL=
# … whose audience is this value (default: ${APP_URL}/api/webhooks/gmail)
PUBSUB_AUDIENCE=
# … and/or a shared secret appended to the push URL as ?token=…  (at least one of the two is required)
PUBSUB_VERIFICATION_TOKEN=

# --- Optional tuning ---------------------------------------------------------------------------------
# Max threads indexed by the initial backfill (newest first).
MAX_BACKFILL_THREADS=1500
# Max total attachment size per send. Default 20, or 4 on Vercel (4.5 MB function body limit).
MAX_UPLOAD_MB=
