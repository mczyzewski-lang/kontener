{
  "name": "emailto-chat",
  "version": "0.1.0",
  "private": true,
  "description": "emailto.chat — your email, now a conversation. A person-first Gmail client.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@googleapis/gmail": "^22.0.2",
    "@prisma/client": "^6.19.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "google-auth-library": "^11.3.1",
    "lucide-react": "^1.59.0",
    "next": "^16.4.2",
    "radix-ui": "^1.8.1",
    "react": "19.2",
    "react-dom": "19.2",
    "sanitize-html": "^2.18.1",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9",
    "vitest": "^5.0.5"
  }
}
