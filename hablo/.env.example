# ─────────────────────────────────────────────────────────────────────────────
# Hablo — environment variables. Copy to .env.local (local) or set them in your
# hosting provider (Vercel → Project → Settings → Environment Variables).
# Never commit real values. Only NEXT_PUBLIC_* values are visible in the browser.
# Step-by-step instructions: docs/SETUP.md
# ─────────────────────────────────────────────────────────────────────────────

# ── Access (required) ────────────────────────────────────────────────────────
# The ONLY e-mail allowed to sign in. Enforced on the server (session check)
# and in the database (sign-up trigger, see supabase/migrations).
HABLO_ALLOWED_EMAIL=

# ── Supabase (required for real use) ────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used for content seeding, the ElevenLabs webhook and the audio cache.
SUPABASE_SERVICE_ROLE_KEY=

# ── Claude API (stories, answer evaluation, conversation analysis) ──────────
ANTHROPIC_API_KEY=
# Optional, defaults to claude-opus-5-5
# ANTHROPIC_MODEL=claude-opus-5-5

# ── ElevenLabs (voice conversations, pronunciation, speech recognition) ─────
ELEVENLABS_API_KEY=
# Created by `npm run elevenlabs:agent` (prints the id)
ELEVENLABS_AGENT_ID=
# Voice Library ids of Spanish (Spain) voices. Female = Lucía & female characters.
ELEVENLABS_VOICE_ID_FEMALE=
ELEVENLABS_VOICE_ID_MALE=
# Optional: voice for word/sentence pronunciation (defaults to the female voice)
# ELEVENLABS_VOICE_ID=
# Optional: calm Polish-capable voice for reading "Moje myśli" (defaults to the female voice)
# ELEVENLABS_VOICE_ID_NARRATOR=
# Workspace → Webhooks → post-call webhook secret (HMAC). Optional but recommended.
ELEVENLABS_WEBHOOK_SECRET=
# Optional model overrides
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# ELEVENLABS_STT_MODEL=scribe_v2
# Agent setup script only (npm run elevenlabs:agent):
# ELEVENLABS_AGENT_LLM=claude-opus-5-5       # a faster model lowers voice latency
# ELEVENLABS_AGENT_TTS_MODEL=eleven_flash_v2_5
# ELEVENLABS_RECORD_VOICE=0                  # 1 = agent keeps audio (needed for replay)
# Cost estimates used for budget limits (USD) — set to your plan's prices
# ELEVENLABS_COST_PER_1K_CHARS=0.18
# ELEVENLABS_COST_PER_AGENT_MINUTE=0.10
# ELEVENLABS_COST_PER_STT_HOUR=0.40

# ── Demo mode (local preview only) ──────────────────────────────────────────
# Without Supabase: HABLO_DEMO_MODE=1 runs a clearly labelled single-user demo
# with data in a local JSON file and NO login. Never enable it on a public URL.
# HABLO_DEMO_MODE=1
# HABLO_DATA_FILE=.hablo-data/db.json
# Automated tests only — deterministic fake AI, labelled "TEST" everywhere:
# HABLO_AI_MOCK=1
